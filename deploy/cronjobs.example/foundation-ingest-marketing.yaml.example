apiVersion: batch/v1
kind: CronJob
metadata:
  name: foundation-ingest-marketing
  namespace: mother-tree
spec:
  schedule: "0 2 * * 0" # Weekly Sunday 02:00
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 1
  jobTemplate:
    spec:
      ttlSecondsAfterFinished: 7200
      backoffLimit: 1
      template:
        spec:
          initContainers:
            - name: clone-repo
              image: alpine/git
              command: ["/bin/sh", "-c"]
              args: ["git clone --depth 1 https://gitlab+deploy-token-40:${TOKEN}@gitlab.aknostic.com/aknostic/marketing.git /data/marketing"]
              env:
                - name: TOKEN
                  valueFrom:
                    secretKeyRef:
                      name: gitlab-deploy-token
                      key: token
              volumeMounts:
                - name: repo
                  mountPath: /data
          imagePullSecrets:
            - name: gitlab-registry
          containers:
            - name: ingest
              # TODO: replace <your-org> with your container registry path before deploying
              image: ghcr.io/<your-org>/mother-tree-jobs:latest
              args: ["ingest", "foundation", "repo", "/data/marketing"]
              env:
                - name: HASURA_URL
                  value: "http://graphql:5000/graphql"
                - name: HASURA_ADMIN_SECRET
                  valueFrom:
                    secretKeyRef:
                      name: hasura-admin-secret
                      key: admin-secret
                - name: SCALEWAY_AI_API_KEY
                  valueFrom:
                    secretKeyRef:
                      name: scaleway-ai
                      key: secret-key
                - name: ANTHROPIC_API_KEY
                  valueFrom:
                    secretKeyRef:
                      name: anthropic-api
                      key: api-key
                - name: ORGANIZATION_NAME
                  value: "Aknostic"
              volumeMounts:
                - name: repo
                  mountPath: /data
              resources:
                requests: {cpu: 100m, memory: 256Mi}
                limits: {cpu: "1", memory: 512Mi}
          volumes:
            - name: repo
              emptyDir: {}
          restartPolicy: Never
