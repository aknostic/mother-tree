apiVersion: batch/v1
kind: CronJob
metadata:
  name: narrative-ingest-site
  namespace: mother-tree
spec:
  schedule: "0 3 * * *" # Daily 03:00
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 1
  jobTemplate:
    spec:
      ttlSecondsAfterFinished: 7200
      backoffLimit: 1
      template:
        spec:
          imagePullSecrets:
            - name: gitlab-registry
          containers:
            - name: ingest
              # TODO: replace <your-org> with your container registry path before deploying
              image: ghcr.io/<your-org>/mother-tree-jobs:latest
              args: ["ingest", "narrative", "sitemap", "https://aknostic.com/sitemap.xml"]
              env:
                - name: HASURA_URL
                  value: "http://graphql:5000/graphql"
                - name: HASURA_ADMIN_SECRET
                  valueFrom:
                    secretKeyRef:
                      name: hasura-admin-secret
                      key: admin-secret
                - name: SCALEWAY_AI_API_KEY
                  valueFrom:
                    secretKeyRef:
                      name: scaleway-ai
                      key: secret-key
                - name: ANTHROPIC_API_KEY
                  valueFrom:
                    secretKeyRef:
                      name: anthropic-api
                      key: api-key
              resources:
                requests: {cpu: 100m, memory: 256Mi}
                limits: {cpu: "1", memory: 512Mi}
          restartPolicy: Never
