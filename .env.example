# Mother Tree — local development environment variables
# Copy to .env and fill in. .env is gitignored.

# --- Scaleway Generative APIs (required for content ingestion + bot responses) ---
SCALEWAY_AI_API_KEY=

# --- Anthropic Claude (optional — used only for triage/arbitration in multi-model scoring) ---
ANTHROPIC_API_KEY=

# --- Slack workspace (optional — without these the bot stays offline; CLI works without them) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Bot configuration ---
ADMIN_EMAIL=
ORGANIZATION_NAME=

# --- GraphQL admin secret (optional; default empty means the GraphQL endpoint is open in dev) ---
ADMIN_SECRET=
