// Fig. 2 — Closed loop: gatherer signal becomes hunter prep, hunter debrief becomes next signal.
// Cited in §6.

digraph closedloop {
  rankdir=LR;
  fontname="Helvetica";
  graph [fontsize=11, ranksep=0.5, nodesep=0.3, pad=0.2];
  node [fontname="Helvetica", fontsize=10, style="rounded,filled", shape=box, fillcolor="#fafafa"];
  edge [fontname="Helvetica", fontsize=9, color=gray40];

  gatherer [label="Gatherer\n(delivery work,\nany channel)", fillcolor="#e8f5e9"];
  signal [label="signal\n+ embedding\nin substrate", fillcolor="#fff3e0", shape=cylinder];
  prep [label="Hunter receives\ncontext-aware\nprep message", fillcolor="#e8f5e9"];
  meeting [label="Hunter\nconversation\nwith prospect"];
  debrief [label="Debrief becomes\nnew signal", fillcolor="#fff3e0"];

  gatherer -> signal [label=" Spotter (Haiku)\n+ Weaver (Sonnet) "];
  signal -> prep [label=" calendar-sync\n vector lookup "];
  prep -> meeting;
  meeting -> debrief;
  debrief -> signal [label=" loop closes ", style=dashed, color=gray50, constraint=false];
}
