// Fig. 1 — Two-layer architecture wrapped around the intelligence substrate.
// Cited in §3.

digraph architecture {
  rankdir=LR;
  fontname="Helvetica";
  graph [fontsize=11, ranksep=0.7, nodesep=0.3, pad=0.2];
  node [fontname="Helvetica", fontsize=10, style="rounded,filled", shape=box, fillcolor="#fafafa"];
  edge [fontname="Helvetica", fontsize=9, color=gray40];

  // Always-on layer
  subgraph cluster_alwayson {
    label="Always-on layer (cronjobs)";
    style=rounded;
    color=gray60;
    fontcolor=gray30;
    fontsize=10;

    foundation [label="foundation-ingest\nweekly"];
    narrative [label="narrative-ingest\ndaily"];
    discipline [label="discipline\nweekly / monthly / cal"];
    pulse [label="pulse-scan\nevery 5 min"];
    training [label="training-deliver\ndaily"];
    embed [label="embed-backfill"];
  }

  // Substrate
  subgraph cluster_substrate {
    label="Intelligence substrate";
    style=rounded;
    color=gray60;
    fontcolor=gray30;
    fontsize=10;

    pg [label="PostgreSQL\n+ pgvector", shape=cylinder, fillcolor="#e3f2fd"];
    graphql [label="PostGraphile\n(GraphQL API)", fillcolor="#fff3e0"];
    intel [label="intelligence.py\n(one path)", fillcolor="#fff3e0"];

    pg -> graphql [arrowhead=none];
    graphql -> intel [arrowhead=none];
  }

  // Interactive layer
  subgraph cluster_interactive {
    label="Interactive layer";
    style=rounded;
    color=gray60;
    fontcolor=gray30;
    fontsize=10;

    bot [label="Slack bot", fillcolor="#e8f5e9"];
    cli [label="mothertree CLI", fillcolor="#e8f5e9"];
  }

  // Inference (split)
  subgraph cluster_scaleway {
    label="Scaleway open-weight (Paris, EU)";
    style="rounded,filled";
    fillcolor="#e3f2fd";
    color="#0277bd";
    fontcolor="#0277bd";
    fontsize=10;

    qwen [label="Qwen 3.5 397B"];
    mistral [label="Mistral Small 3.2"];
    bge [label="BGE Multilingual"];
    judges [label="Devstral / Llama / Gemma"];
  }

  subgraph cluster_anthropic {
    label="Anthropic boundary (small)";
    style="rounded,filled";
    fillcolor="#ffebee";
    color="#c62828";
    fontcolor="#c62828";
    fontsize=10;

    haiku [label="Haiku 4.5"];
    sonnet [label="Sonnet 4.6"];
  }

  // Substrate connections
  foundation -> intel;
  narrative -> intel;
  discipline -> intel;
  pulse -> intel;
  training -> intel;
  embed -> intel;

  intel -> bot;
  intel -> cli;

  // Inference annotation (one combined edge per cluster, dashed)
  qwen -> intel [style=dashed, color="#0277bd", arrowhead=none, constraint=false];
  haiku -> intel [style=dashed, color="#c62828", arrowhead=none, constraint=false];
}
