// Fig. 4 — Model selection: workload class to model to provider, EU/US split.
// Cited in §5.

digraph modelselection {
  rankdir=LR;
  fontname="Helvetica";
  graph [fontsize=11, ranksep=1.0, nodesep=0.25, pad=0.2];
  node [fontname="Helvetica", fontsize=10, style="rounded,filled", shape=box, fillcolor="#fafafa"];
  edge [fontname="Helvetica", fontsize=9, color=gray40];

  subgraph cluster_workloads {
    label="Workloads";
    style=rounded;
    color=gray60;
    fontcolor=gray30;
    fontsize=10;

    extract [label="Light extraction\n+ classification"];
    deep [label="Deep extraction"];
    persona [label="Persona responses"];
    embed [label="Embeddings"];
    score [label="Judges (3×)"];
    spotter [label="Spotter"];
    weaver [label="Weaver"];
    triage [label="Triage"];
    arbitrate [label="Arbitration"];
  }

  subgraph cluster_eu {
    label="European open weight (Scaleway, Paris)";
    style="rounded,filled";
    fillcolor="#e3f2fd";
    color="#0277bd";
    fontcolor="#0277bd";
    fontsize=10;

    mistral [label="Mistral Small 3.2"];
    qwen [label="Qwen 3.5 397B"];
    bge [label="BGE Multilingual"];
    judges [label="Devstral 2\nLlama 3.3\nGemma 3"];
  }

  subgraph cluster_us {
    label="Closed frontier (Anthropic)";
    style="rounded,filled";
    fillcolor="#ffebee";
    color="#c62828";
    fontcolor="#c62828";
    fontsize=10;

    haiku [label="Haiku 4.5"];
    sonnet [label="Sonnet 4.6"];
  }

  extract -> mistral [color="#0277bd"];
  deep -> qwen [color="#0277bd"];
  persona -> qwen [color="#0277bd"];
  embed -> bge [color="#0277bd"];
  score -> judges [color="#0277bd"];

  spotter -> haiku [color="#c62828"];
  weaver -> sonnet [color="#c62828"];
  triage -> haiku [color="#c62828"];
  arbitrate -> sonnet [color="#c62828"];
}
